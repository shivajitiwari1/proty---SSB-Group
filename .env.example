# Copy this file to .env and fill in SMTP_PASS for local development.
# In production, add the same keys in Vercel:
# Project -> Settings -> Environment Variables

# Hostinger mail server (SMTP)
# Reference: IMAP imap.hostinger.com:993 (SSL), POP3 pop.hostinger.com:995 (SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ssbgroups.in
# If the password contains # or spaces, wrap it in quotes: SMTP_PASS="..."
SMTP_PASS=your-hostinger-mailbox-password
MAIL_TO=info@ssbgroups.in
MAIL_FROM=info@ssbgroups.in
MAIL_FROM_NAME=SSB Group Website
